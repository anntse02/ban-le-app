# ==========================================
# CẤU HÌNH GỬI EMAIL (SMTP GMAIL / SENDGRID)
# ==========================================
# Tên hiển thị người gửi trong email
SENDER_NAME="Quản Lý Bán Lẻ"

# Máy chủ SMTP (Mặc định Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Tài khoản Gmail gửi mail
SMTP_USER=your_email@gmail.com

# Mật khẩu ứng dụng 16 ký tự của Gmail (App Password, không phải mật khẩu đăng nhập Gmail thường)
# Hướng dẫn tạo: Google Account -> Security (Bảo mật) -> 2-Step Verification -> App Passwords
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# ==========================================
# CẤU HÌNH FIREBASE FIRESTORE
# Lấy từ Firebase Console -> Project Settings -> General -> Your Apps (Web App)
# ==========================================
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
